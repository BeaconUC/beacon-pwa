{
    "name": "beacon-pwa",
    "sources": [
        {
            "dir": "src",
            "subdirs": true
        }
    ],
    "package-specs": [
        {
            "module": "esmodule",
            "in-source": true
        }
    ],
    "suffix": ".res.js",
    "bs-dependencies": [
        "@rescript/core",
        "rescript-webapi"
    ],
    "bsc-flags": [
        "-open RescriptCore"
    ],
    "jsx": {
        "version": 4
    },
    "gentypeconfig": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "generatedFileExtension": ".gen.tsx"
    }
}